{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",
		"strict": true,
		"types": ["node", "vscode"],
		"noUncheckedIndexedAccess": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "out",
		"sourceMap": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
